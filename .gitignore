/build/
/.vscode/*
!/.vscode/settings.json
!/.vscode/tasks.json
!/.vscode/launch.json
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.elf
*.bin
*.hex
*.map
*.out

/.cache/

# XRobot modules are restored by the CLI from Modules/*.yaml.
/Modules/*
!/Modules/*.yaml

# Project-specific business modules without remote module repos.
!/Modules/Scheduler/
!/Modules/Scheduler/**
!/Modules/LineTracker/
!/Modules/LineTracker/**
!/Modules/SimpleDicision/
!/Modules/SimpleDicision/**
